# Database
DATABASE_URL=postgresql://betting:betting@localhost:5432/betting_dev

# Redis
REDIS_URL=redis://localhost:6379

# Auth — generate with: openssl rand -base64 64
JWT_SECRET=change_me_in_production
JWT_REFRESH_SECRET=change_me_in_production_too
ADMIN_JWT_SECRET=change_me_in_production_admin

# SMS (Africa's Talking)
AT_USERNAME=sandbox
AT_API_KEY=your_at_api_key

# Payment provider webhooks — shared secret required on inbound M-Pesa/MTN/Airtel
# callbacks (sent in the x-webhook-secret header). Leave empty until a real
# provider is connected; while empty the webhook routes reject every request.
PAYMENT_WEBHOOK_SECRET=

# CORS — set to your web app URL in production
CORS_ORIGIN=http://localhost:3000

# App
NODE_ENV=development
PORT=3001
